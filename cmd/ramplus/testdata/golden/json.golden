    }
  ],
  "steps": [
    {
      "kind": "set_value",
      "path": "/sys/module/zswap/parameters/compressor",
      "content": "lz4",
      "description": "zswap.compressor = lz4 (запись в /sys/module/zswap/parameters/compressor)"
    },
    {
      "kind": "set_value",
      "path": "/sys/module/zswap/parameters/enabled",
      "content": "Y",
      "description": "zswap.enabled = Y (запись в /sys/module/zswap/parameters/enabled)"
    },
    {
      "kind": "write_file",
      "path": "/etc/sysctl.d/99-ramplus.conf",
      "mode": 420,
      "content": "# Managed by RamPlus: do not edit, use `ramplus profile`.\n# Профиль: zswap-lz4 (экспериментальный: не подтверждён бенчмарком на SSD)\n# Применяется systemd-sysctl при загрузке; имя 99-ramplus.conf — чтобы идти после остальных.\nvm.swappiness = 60\nvm.page-cluster = 3\nvm.watermark_scale_factor = 10\nvm.vfs_cache_pressure = 100\n",
      "description": "записать /etc/sysctl.d/99-ramplus.conf"
    },
    {
      "kind": "write_file",
      "path": "/etc/systemd/system/ramplus-zswap.service",
      "mode": 420,
      "content": "# Managed by RamPlus: do not edit, use `ramplus profile`.\n# Профиль: zswap-lz4 (экспериментальный: не подтверждён бенчмарком на SSD)\n# Пишет параметры zswap при загрузке (kernel cmdline не меняется).\n[Unit]\nDescription=RamPlus zswap parameters (profile zswap-lz4)\nDocumentation=https://github.com/ashot0907/ramplus\nDefaultDependencies=no\nAfter=local-fs.target systemd-modules-load.service\nBefore=swap.target\nConditionPathIsDirectory=/sys/module/zswap/parameters\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c 'echo lz4 \u003e /sys/module/zswap/parameters/compressor'\nExecStart=/bin/sh -c 'echo 20 \u003e /sys/module/zswap/parameters/max_pool_percent'\nExecStart=/bin/sh -c 'echo Y \u003e /sys/module/zswap/parameters/enabled'\n\n[Install]\nWantedBy=swap.target\n",
      "reload": true,
      "description": "записать /etc/systemd/system/ramplus-zswap.service"
